FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
ENCRYPTION_KEY=change-this-to-a-fernet-key
DATABASE_URL=sqlite:///instance/app.db
SESSION_TYPE=filesystem
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_LOGIN_PER_HOUR=10
RATE_LIMIT_RESUME_UPLOADS_PER_DAY=10
RATE_LIMIT_API_CALLS_PER_MINUTE=60
ENABLE_INSTITUTION_BRANDING=false
INSTITUTION_NAME=
